{
  "functions": {
    "api/legacy.js": {
      "includeFiles": "legacy.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index-v2.html"
    },
    {
      "source": "/index.html",
      "destination": "/index-v2.html"
    }
  ],
  "redirects": [
    {
      "source": "/legacy.html",
      "destination": "/api/legacy",
      "permanent": false
    }
  ]
}
